<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <title>Invoice {{metadata.invoice_number}}</title>
    <style>
      {{{styles}}}
    </style>
  </head>
  <body
    class="m-0 box-border px-[50px] py-10 text-xs text-[#1a1a1a] [font-family:'Helvetica_Neue',Arial,sans-serif]"
  >

    {{#with metadata}}
      <div
        class="mb-[30px] flex items-start justify-between border-b-[3px] border-[#1a1a1a] pb-5"
      >
        <h1 class="m-0 text-[28px] tracking-[1px]">INVOICE</h1>
        <div class="text-right text-xs leading-[1.6]">
          <div><span class="mr-2 text-[#777]">No.</span>{{invoice_number}}</div>
          <div><span class="mr-2 text-[#777]">Tanggal Terbit</span>{{issue_date}}</div>
          <div><span class="mr-2 text-[#777]">Jatuh Tempo</span>{{due_date}}</div>
        </div>
      </div>
    {{/with}}

    <div class="mb-[30px] flex justify-between">
      {{#with sender}}
        <div class="w-[45%]">
          <div
            class="mb-1.5 text-[10px] uppercase tracking-[0.5px] text-[#777]"
          >Dari</div>
          <div class="mb-1 text-sm font-bold">{{company_name}}</div>
          <div>{{address}}</div>
        </div>
      {{/with}}
      {{#with customer}}
        <div class="w-[45%]">
          <div
            class="mb-1.5 text-[10px] uppercase tracking-[0.5px] text-[#777]"
          >Kepada</div>
          <div class="mb-1 text-sm font-bold">{{company_name}}</div>
          <div>{{address}}</div>
        </div>
      {{/with}}
    </div>

    <table class="mb-5 w-full border-collapse">
      <thead>
        <tr>
          <th
            class="bg-[#1a1a1a] px-3 py-2.5 text-left text-[11px] uppercase text-white"
          >Deskripsi</th>
          <th
            class="bg-[#1a1a1a] px-3 py-2.5 text-right text-[11px] uppercase text-white"
          >Qty</th>
          <th
            class="bg-[#1a1a1a] px-3 py-2.5 text-right text-[11px] uppercase text-white"
          >Harga Satuan</th>
          <th
            class="bg-[#1a1a1a] px-3 py-2.5 text-right text-[11px] uppercase text-white"
          >Subtotal</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
          <tr>
            <td
              class="border-b border-[#eee] px-3 py-2.5 text-xs"
            >{{this.description}}</td>
            <td
              class="border-b border-[#eee] px-3 py-2.5 text-right text-xs"
            >{{this.quantity}}</td>
            <td
              class="border-b border-[#eee] px-3 py-2.5 text-right text-xs"
            >{{this.formatted_unit_price}}</td>
            <td
              class="border-b border-[#eee] px-3 py-2.5 text-right text-xs"
            >{{this.formatted_subtotal}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>

    {{#with calculations}}
      <div class="ml-auto w-[300px]">
        <div class="flex justify-between py-1.5 text-xs">
          <span>Subtotal</span>
          <span>{{formatted_subtotal}}</span>
        </div>
        <div class="flex justify-between py-1.5 text-xs">
          <span>Pajak ({{tax_rate_percent}}%)</span>
          <span>{{formatted_tax}}</span>
        </div>
        <div class="flex justify-between py-1.5 text-xs">
          <span>Diskon</span>
          <span>-{{formatted_discount}}</span>
        </div>
        <div
          class="mt-1.5 flex justify-between border-t-2 border-[#1a1a1a] pt-2.5 text-[15px] font-bold"
        >
          <span>Grand Total</span>
          <span>{{formatted_grand_total}}</span>
        </div>
      </div>
    {{/with}}

    <div class="mt-[50px] text-center text-[10px] text-[#999]">
      Dokumen ini dibuat secara otomatis oleh sistem.
    </div>

  </body>
</html>