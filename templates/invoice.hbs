<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <title>Invoice {{metadata.invoice_number}}</title>
    <style>
      @page {
        margin: 0;
      }
      * {
        box-sizing: border-box;
      }
      body {
        font-family: "Helvetica Neue", Arial, sans-serif;
        font-size: 12px;
        color: #1a1a1a;
        margin: 0;
        padding: 40px 50px;
      }
      .header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 3px solid #1a1a1a;
        padding-bottom: 20px;
        margin-bottom: 30px;
      }
      .header h1 {
        font-size: 28px;
        margin: 0;
        letter-spacing: 1px;
      }
      .header .invoice-meta {
        text-align: right;
        font-size: 12px;
        line-height: 1.6;
      }
      .invoice-meta .label {
        color: #777;
        margin-right: 8px;
      }
      .parties {
        display: flex;
        justify-content: space-between;
        margin-bottom: 30px;
      }
      .party {
        width: 45%;
      }
      .party .title {
        font-size: 10px;
        text-transform: uppercase;
        color: #777;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
      }
      .party .company-name {
        font-weight: bold;
        font-size: 14px;
        margin-bottom: 4px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
      }
      thead th {
        background-color: #1a1a1a;
        color: #fff;
        text-align: left;
        padding: 10px 12px;
        font-size: 11px;
        text-transform: uppercase;
      }
      thead th.num {
        text-align: right;
      }
      tbody td {
        padding: 10px 12px;
        border-bottom: 1px solid #eee;
        font-size: 12px;
      }
      tbody td.num {
        text-align: right;
      }
      .summary {
        width: 300px;
        margin-left: auto;
      }
      .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 6px 0;
        font-size: 12px;
      }
      .summary-row.grand-total {
        border-top: 2px solid #1a1a1a;
        margin-top: 6px;
        padding-top: 10px;
        font-weight: bold;
        font-size: 15px;
      }
      .footer {
        margin-top: 50px;
        font-size: 10px;
        color: #999;
        text-align: center;
      }
    </style>
  </head>
  <body>

    <div class="header">
      <h1>INVOICE</h1>
      <div class="invoice-meta">
        <div><span class="label">No.</span>{{metadata.invoice_number}}</div>
        <div><span class="label">Tanggal Terbit</span>{{metadata.issue_date}}</div>
        <div><span class="label">Jatuh Tempo</span>{{metadata.due_date}}</div>
      </div>
    </div>

    <div class="parties">
      <div class="party">
        <div class="title">Dari</div>
        <div class="company-name">{{sender.company_name}}</div>
        <div>{{sender.address}}</div>
      </div>
      <div class="party">
        <div class="title">Kepada</div>
        <div class="company-name">{{customer.company_name}}</div>
        <div>{{customer.address}}</div>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Deskripsi</th>
          <th class="num">Qty</th>
          <th class="num">Harga Satuan</th>
          <th class="num">Subtotal</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
          <tr>
            <td>{{this.description}}</td>
            <td class="num">{{this.quantity}}</td>
            <td class="num">{{this.formatted_unit_price}}</td>
            <td class="num">{{this.formatted_subtotal}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>

    <div class="summary">
      <div class="summary-row">
        <span>Subtotal</span>
        <span>{{calculations.formatted_subtotal}}</span>
      </div>
      <div class="summary-row">
        <span>Pajak ({{calculations.tax_rate_percent}}%)</span>
        <span>{{calculations.formatted_tax}}</span>
      </div>
      <div class="summary-row">
        <span>Diskon</span>
        <span>-{{calculations.formatted_discount}}</span>
      </div>
      <div class="summary-row grand-total">
        <span>Grand Total</span>
        <span>{{calculations.formatted_grand_total}}</span>
      </div>
    </div>

    <div class="footer">
      Dokumen ini dibuat secara otomatis oleh sistem.
    </div>

  </body>
</html>